# Supabase (local values come from `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Public URL of the site, used in email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (Resend). Without a key, emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM="CannaDry <no-reply@cannadry.example>"
# Where "new access request" notifications go
ADMIN_NOTIFY_EMAIL=
